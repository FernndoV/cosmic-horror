package com.vefe.cosmichorror.adapters.out;

import com.vefe.cosmichorror.domain.Campaign;
import com.vefe.cosmichorror.domain.NarrativeGenerationPort;
import com.vefe.cosmichorror.domain.NarrativeProposal;
import com.vefe.cosmichorror.domain.NarrativeRequest;
import com.vefe.cosmichorror.domain.PlayerCharacter;
import java.util.Locale;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.stereotype.Component;

@Component
@ConditionalOnProperty(name = "ai.provider", havingValue = "stub", matchIfMissing = true)
public class StubNarrativeGenerationAdapter implements NarrativeGenerationPort {
  private static final String DEFAULT_LOCATION = "el lugar";

  @Override
  public String generateOpening(Campaign campaign, PlayerCharacter character) {
    String location = locationOf(campaign);
    String setting = campaign == null || isBlank(campaign.setting())
        ? "la noche" : campaign.setting().trim();
    return "En %s, %s llega para investigar una anomalía ligada a %s. "
        .formatted(location, character.name(), setting)
        + "La señal aparece donde no debería existir y obliga a elegir entre seguir sus huellas, "
        + "buscar ayuda o retirarse antes de que cambie la marea de la historia.";
  }

  @Override
  public NarrativeProposal generate(NarrativeRequest request) {
    String location = locationOf(request.campaign());
    String action = request.action() == null ? "" : request.action().toLowerCase(Locale.ROOT);

    if (request.recentTurns() != null && request.recentTurns().size() >= 5) {
      return new NarrativeProposal(
          "En %s, eliges una salida y el misterio queda resuelto: las marcas pierden su forma, "
              + "la presencia se retira y el precio de haberla comprendido queda en tu memoria. "
              + "Al amanecer, el lugar conserva las huellas de lo ocurrido, pero ya no reclama nada de ti."
              .formatted(location),
          null, 1, "CONCLUDED", "ESCAPE");
    }
    if (containsAny(action, "exam", "mir", "observar", "investig", "marca", "mapa")) {
      return new NarrativeProposal(
          "En %s, las marcas de la superficie se reordenan bajo tus dedos y forman un mapa "
              + "de una costa que no existe. La línea termina en un punto que coincide con tu "
              + "posición y deja una ruta verificable hacia la siguiente escena."
              .formatted(location),
          "impossible_map", 1);
    }
    if (containsAny(action, "abr", "entr", "puerta", "bajar", "sótano", "sotano")) {
      return new NarrativeProposal(
          "En %s, la entrada cede con un suspiro húmedo y deja ver un descenso mucho más profundo "
              + "de lo que permite el edificio o el terreno. La humedad trae voces desde abajo; "
              + "aún puedes seguirlas o sellar el acceso."
              .formatted(location),
          "impossible_staircase", 2);
    }
    if (containsAny(action, "escuch", "oír", "oir", "habl", "llam", "responder")) {
      return new NarrativeProposal(
          "En %s, el sonido se detiene. Después, tres golpes responden desde un punto oculto, "
              + "imitando exactamente tu ritmo cardíaco. La respuesta procede de una dirección "
              + "concreta y alguien al otro lado espera que contestes."
              .formatted(location),
          "three_knocks", 1);
    }
    if (containsAny(action, "huir", "corre", "salir", "alej", "escap")) {
      return new NarrativeProposal(
          "En %s, retrocedes hacia la salida y descubres que el trayecto ha cambiado: la ruta "
              + "conocida termina ante una barrera de agua, niebla o piedra. La retirada sigue "
              + "siendo posible, pero exige decidir qué pista abandonas atrás."
              .formatted(location),
          null, 1);
    }
    if (containsAny(action, "invent", "objeto", "llave", "linterna", "sacar", "usar")) {
      return new NarrativeProposal(
          "En %s, al revisar tus pertenencias encuentras algo que no recuerdas haber guardado: "
              + "una llave fría, cubierta de sal negra. Su óxido coincide con una cerradura "
              + "cercana, pero llevarla allí hará visible tu presencia."
              .formatted(location),
          "salt_key", 0);
    }
    return new NarrativeProposal(
        "En %s, tu acción altera el equilibrio de la escena. Algo responde desde un punto que "
            + "no aparece en ningún plano y obliga a concretar el siguiente movimiento: observar, "
            + "preguntar o cambiar de ruta."
            .formatted(location),
        null, 0);
  }

  private String locationOf(Campaign campaign) {
    if (campaign == null) return DEFAULT_LOCATION;
    if (!isBlank(campaign.location())) return campaign.location().trim();
    if (!isBlank(campaign.name())) return campaign.name().trim();
    return DEFAULT_LOCATION;
  }

  private boolean isBlank(String value) {
    return value == null || value.isBlank();
  }

  private boolean containsAny(String value, String... terms) {
    for (String term : terms) {
      if (value.contains(term)) return true;
    }
    return false;
  }
}
